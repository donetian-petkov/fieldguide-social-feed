NODE_ENV=development
APP_NAME=Fieldguide
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WORKER_CONCURRENCY=2
PORT=4000
WEB_PORT=3000
DATABASE_URL=mysql://fieldguide:fieldguide@127.0.0.1:3306/fieldguide
SHADOW_DATABASE_URL=mysql://fieldguide:fieldguide@127.0.0.1:3306/fieldguide_shadow
REDIS_URL=redis://127.0.0.1:6379
COOKIE_SECRET=replace-with-a-long-random-string
SESSION_TTL_HOURS=168
MODE_SWITCH_TTL_MINUTES=10
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_AI_PROVIDER=openai
SUMMARY_MODEL=gpt-4.1-mini
TRANSLATION_MODEL=gpt-4.1-mini
ASK_MODEL=gpt-4.1-mini
NEWSLETTER_MODEL=gpt-4.1-mini
RESEND_API_KEY=
EMAIL_FROM=Fieldguide <noreply@example.com>
ENABLE_EMAIL=false
DEMO_MODE=false
AUTO_SHUTDOWN_ENABLED=true
AUTO_SHUTDOWN_IDLE_HOURS=4
SEED_USER_PASSWORD=change-this-local-seed-password
NEXT_PUBLIC_DEMO_FALLBACK=false
