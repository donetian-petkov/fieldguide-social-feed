generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum InterfaceLanguage {
  en
  bg
}

enum ContentLanguageMode {
  single
  dual
}

enum ThemeMode {
  light
  dark
  system
}

enum ContentMode {
  kid
  standard
  adult
}

enum ContentKind {
  external_article
  youtube_video
  community_post
  generated_story
}

enum FeedKind {
  rss
  youtube
  custom
}

enum SourceStatus {
  active
  paused
  error
}

enum AudienceLabel {
  kid_safe
  standard_only
  adult_only
}

enum SubjectTag {
  history
  art
  books
  movies
  country_knowledge
  photography
  nature
  video
  community
}

enum VibePreset {
  museum
  archive
  field_notes
  cinema
  naturalist
}

enum SourceType {
  editorial
  community
  adult_educational
}

enum SubmissionStatus {
  pending
  approved
  rejected
}

enum GeneratedStoryStatus {
  queued
  draft
  approved
  rejected
  failed
}

enum NewsletterCadence {
  daily
  weekly
}

enum DeliveryStatus {
  queued
  sent
  skipped
  failed
}

enum SystemScope {
  api
  worker
  ingestion
  email
  ai
}

enum SystemLevel {
  error
  warn
}

model User {
  id                 String               @id @default(cuid())
  username           String               @unique
  email              String               @unique
  passwordHash       String
  role               UserRole             @default(user)
  suspendedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  settings           UserSettings?
  sessions           Session[]
  authoredItems      ContentItem[]        @relation("AuthoredItems")
  comments           Comment[]
  albums             Album[]
  saves              SavedItem[]
  hiddenItems        HiddenItem[]
  itemViews          ItemView[]
  submissions        Submission[]
  reviewedItems      Submission[]         @relation("SubmissionReviewer")
  generatedStoryRequests GeneratedStoryDraft[] @relation("GeneratedStoryRequester")
  generatedStoryReviews  GeneratedStoryDraft[] @relation("GeneratedStoryReviewer")
  passwordResetTokens PasswordResetToken[]
  modeSwitchAudits   ModeSwitchAudit[]
  aiUsage            AiUsageLedger[]
  newsletterDeliveries NewsletterDelivery[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                   String              @id @default(cuid())
  userId               String              @unique
  displayName          String
  language             InterfaceLanguage   @default(en)
  contentLanguageMode  ContentLanguageMode @default(single)
  vibePreset           VibePreset          @default(museum)
  fontFamily           String
  fontScale            String
  imageMode            String
  themeMode            ThemeMode           @default(light)
  contentMode          ContentMode         @default(standard)
  newsletterEnabled    Boolean             @default(false)
  newsletterCadence    NewsletterCadence   @default(weekly)
  askAiEnabled         Boolean             @default(true)
  protectedModeEnabled Boolean             @default(true)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Source {
  id              String         @id
  name            String
  slug            String         @unique
  iconUrl         String
  siteUrl         String
  description     String         @db.Text
  subjectsJson    String         @db.Text
  language        InterfaceLanguage
  defaultAudience AudienceLabel
  sourceType      SourceType
  status          SourceStatus
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  feeds           SourceFeed[]
  items           ContentItem[]
}

model SourceFeed {
  id              String   @id @default(cuid())
  sourceId        String
  kind            FeedKind
  feedUrl         String   @unique
  pollIntervalSec Int      @default(900)
  etag            String?
  lastModified    String?
  lastError       String?  @db.Text
  lastCheckedAt   DateTime?
  source          Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model ContentItem {
  id              String         @id
  slug            String         @unique
  dedupeKey       String?        @unique @db.VarChar(191)
  kind            ContentKind
  sourceId        String
  authorId        String?
  publishedAt     DateTime
  originalTitle   String
  originalSummary String         @db.Text
  summaryAiProvider String?
  summaryAiModel    String?
  summaryAiInputTokens Int?
  summaryAiOutputTokens Int?
  summaryAiTotalCostUsd Decimal? @db.Decimal(10, 4)
  summaryAiGeneratedAt DateTime?
  bodyMarkdown    String?        @db.LongText
  coverImageUrl   String
  externalUrl     String?
  youtubeVideoId  String?
  subject         SubjectTag
  classificationAiProvider String?
  classificationAiModel    String?
  classificationAiInputTokens Int?
  classificationAiOutputTokens Int?
  classificationAiTotalCostUsd Decimal? @db.Decimal(10, 4)
  classificationAiGeneratedAt DateTime?
  audience        AudienceLabel
  commentsLocked  Boolean        @default(false)
  hiddenByDefault Boolean        @default(false)
  pinned          Boolean        @default(false)
  removedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  source          Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  author          User?          @relation("AuthoredItems", fields: [authorId], references: [id], onDelete: SetNull)
  translations    ContentTranslation[]
  tags            ContentTag[]
  comments        Comment[]
  saves           SavedItem[]
  hiddenItems     HiddenItem[]
  itemViews       ItemView[]
  albumItems      AlbumItem[]
  pinnedSlots     PinnedSlot[]
  aiUsage         AiUsageLedger[]
  generatedStoryDrafts GeneratedStoryDraft[]
  newsletterDeliveries NewsletterDeliveryItem[]
}

model ContentTranslation {
  id          String            @id @default(cuid())
  itemId      String
  language    InterfaceLanguage
  title       String
  summary     String            @db.Text
  slug        String
  aiProvider  String?
  aiModel     String?
  aiInputTokens Int?
  aiOutputTokens Int?
  aiTotalCostUsd Decimal?       @db.Decimal(10, 4)
  aiGeneratedAt DateTime?
  item        ContentItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, language])
}

model ContentTag {
  id     String      @id @default(cuid())
  itemId String
  label  String
  type   String
  value  String
  item   ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Comment {
  id             String      @id @default(cuid())
  itemId         String
  authorId       String
  body           String      @db.Text
  createdAt      DateTime    @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  moderationNote String?     @db.Text
  item           ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author         User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Album {
  id          String      @id @default(cuid())
  ownerId     String
  title       String
  description String      @db.Text
  coverItemId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items       AlbumItem[]
}

model AlbumItem {
  albumId   String
  itemId    String
  position  Int
  createdAt DateTime    @default(now())
  album     Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  item      ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([albumId, itemId])
}

model SavedItem {
  userId    String
  itemId    String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
}

model HiddenItem {
  userId    String
  itemId    String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
}

model ItemView {
  userId         String
  itemId         String
  viewCount      Int         @default(1)
  firstViewedAt  DateTime    @default(now())
  lastViewedAt   DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  item           ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@index([itemId])
}

model Submission {
  id            String           @id @default(cuid())
  type          String
  title         String
  sourceUrl     String?
  body          String?          @db.LongText
  submittedById String
  status        SubmissionStatus @default(pending)
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  submittedBy   User             @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy    User?            @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model GeneratedStoryDraft {
  id               String               @id @default(cuid())
  status           GeneratedStoryStatus @default(queued)
  subject          SubjectTag
  prompt           String               @db.Text
  requestedById    String
  reviewedById     String?
  itemId           String?
  title            String?
  summary          String?              @db.Text
  bodyMarkdown     String?              @db.LongText
  citationsJson    String               @db.LongText
  verificationJson String?              @db.LongText
  failureReason    String?              @db.Text
  totalCostUsd     Decimal              @default(0) @db.Decimal(10, 4)
  generatedAt      DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  requestedBy      User                 @relation("GeneratedStoryRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy       User?                @relation("GeneratedStoryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  item             ContentItem?         @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([subject, createdAt])
}

model AiConfig {
  id                    Int      @id
  provider              String
  summaryModel          String
  translationModel      String
  askModel              String
  newsletterModel       String
  monthlyBudgetUsd      Decimal  @db.Decimal(10, 2)
  perJobBudgetUsd       Decimal  @db.Decimal(10, 2)
  autoDowngrade         Boolean  @default(true)
  pauseOnBudgetExceeded Boolean  @default(false)
  openaiApiKeyCiphertext    String? @db.LongText
  anthropicApiKeyCiphertext String? @db.LongText
  openrouterApiKeyCiphertext String? @db.LongText
  updatedAt             DateTime @updatedAt
}

model AiUsageLedger {
  id           String      @id @default(cuid())
  userId       String?
  itemId       String?
  provider     String
  model        String
  purpose      String
  inputTokens  Int
  outputTokens Int
  totalCostUsd Decimal     @db.Decimal(10, 4)
  createdAt    DateTime    @default(now())
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  item         ContentItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
}

model SystemErrorEvent {
  id         String      @id @default(cuid())
  scope      SystemScope
  message    String      @db.Text
  level      SystemLevel
  resolvedAt DateTime?
  createdAt  DateTime    @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PinnedSlot {
  id        String      @id @default(cuid())
  feed      String
  slot      Int
  itemId    String
  createdAt DateTime    @default(now())
  item      ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([feed, slot])
}

model ModeSwitchAudit {
  id         String      @id @default(cuid())
  userId     String
  fromMode   ContentMode
  toMode     ContentMode
  verifiedAt DateTime    @default(now())
  ipAddress  String?
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NewsletterDelivery {
  id                String               @id @default(cuid())
  userId            String
  cadence           NewsletterCadence
  status            DeliveryStatus       @default(queued)
  subjectLine       String
  summaryText       String?              @db.LongText
  selectionAiProvider String?
  selectionAiModel    String?
  selectionAiInputTokens Int?
  selectionAiOutputTokens Int?
  selectionAiTotalCostUsd Decimal?      @db.Decimal(10, 4)
  selectionAiGeneratedAt DateTime?
  summaryAiProvider String?
  summaryAiModel    String?
  summaryAiInputTokens Int?
  summaryAiOutputTokens Int?
  summaryAiTotalCostUsd Decimal?        @db.Decimal(10, 4)
  summaryAiGeneratedAt DateTime?
  providerMessageId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             NewsletterDeliveryItem[]
}

model NewsletterDeliveryItem {
  deliveryId String
  itemId     String
  position   Int
  delivery   NewsletterDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  item       ContentItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([deliveryId, itemId])
}
